<?xml version="1.0" encoding="utf-8"?>
<!--
   Weaverse is offline-first with no cloud sync, so Auto Backup is the only
   place a user's library leaves the device (Google's encrypted device backup).
   Only database + file domains are included below, which puts this in
   opt-in mode — the encrypted API-key sharedpref store (never listed) is
   excluded from the backup by omission, not by an explicit <exclude>.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="." />
</full-backup-content>
