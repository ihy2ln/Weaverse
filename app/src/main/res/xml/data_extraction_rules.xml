<?xml version="1.0" encoding="utf-8"?>
<!--
   Only database + file domains are included, which puts both rule sets in
   opt-in mode — the encrypted API-key sharedpref store (never listed) is
   excluded by omission, not by an explicit <exclude>.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
